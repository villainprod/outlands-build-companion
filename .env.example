# Copy to .env.local for local development. Leave blank to run without accounts.
# Both values are in Supabase → Project Settings → API Keys (use the publishable key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Set to true after turning on the Discord provider in Supabase.
VITE_ENABLE_DISCORD=false
